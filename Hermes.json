#Hermes Desktop MCP Configuration 

#Background: Ollama with Qwen3.6 and Qwen3.8 won’t be able to load all the 218 MCP tools from the aec-model-bridge. Therefore, it’s necessary to manually include the required tools for Revit usage. 

#The following mcp.json can be easily set up through the UI. The following tested setup includes 163 tools and can run on an ASUS Z13 with 128 GB of memory. 

{
  "mcpServers": {
    "aec-model-bridge": {
      "args": [
        "-m",
        "revit_mcp_server.mcp_server"
      ],
      "command": "C:\\Users\\dtl\\aec-model-bridge\\.venv\\Scripts\\python.exe",
      "env": {
        "MCP_REVIT_ALLOWED_DIRECTORIES": "C:\\RevitProjects",
        "MCP_REVIT_BRIDGE_URL": "http://127.0.0.1:3000",
        "MCP_REVIT_MODE": "bridge",
        "MCP_REVIT_WORKSPACE_DIR": "C:\\RevitProjects"
      },
      "tools": {
        "include": [
          "aec_map_workspace_path",
          "aec_register_mapping",
          "aec_translate_id",
          "approve_plan",
          "execute_plan",
          "list_pending_plans",
          "plan_actions",
          "reject_plan",
          "rollback_plan",
          "ifc_get_bounding_box",
          "ifc_get_metadata",
          "ifc_get_properties",
          "ifc_get_spatial_structure",
          "ifc_health",
          "ifc_query_elements",
          "ifc_validate",
          "job_cancel",
          "job_status",
          "familytype_mapper_audit_families",
          "familytype_mapper_list_type_mappings",
          "model_inspector_ask",
