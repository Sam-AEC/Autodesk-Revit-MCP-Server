# revit_sparing_place (write mode). Places the crossings found by _sparing_detect.ipy as sparing families or native
# openings. One Transaction per sparing, all of them in one TransactionGroup (Runner of the revit_docs write prelude).
# ARGS = detection args (see _sparing_detect.ipy) + {tag, mode ('family'|'opening'), family_name, type_name,
#         size_parameters {width, height, depth, diameter -> instance parameter name}, status_parameter, status_value,
#         crossing_ids, max_sparings, on_error, dry_run}
# Ownership: every sparing gets the Extensible Storage tag (tag, key 'sparing:' + crossing_id, kind). A crossing that
# already has a sparing of this tag and key is replaced; any other opening or sparing at a crossing is left alone and
# the crossing is skipped. UNVERIFIED against a live Revit: see the module docstring.
from Autodesk.Revit.DB.Structure import StructuralType

KEY_PREFIX = "sparing:"
SYM = [None]


def name_of(e):
    try:
        return e.Name
    except Exception:
        pass
    try:
        return Element.Name.GetValue(e)
    except Exception:
        return ""


def find_symbol():
    fams = [f for f in FilteredElementCollector(doc).OfClass(Family) if name_of(f) == ARGS["family_name"]]
    if not fams:
        names = sorted(set([name_of(f) for f in FilteredElementCollector(doc).OfClass(Family)]))
        return None, "family '%s' is not loaded in this project; loaded families include: %s" % (ARGS["family_name"], ", ".join(names[:40]))
    types = []
    for sid in fams[0].GetFamilySymbolIds():
        s = doc.GetElement(sid)
        if s is None:
            continue
        types.append(name_of(s))
        if name_of(s) == ARGS["type_name"]:
            return s, None
    types.sort()
    return None, "family '%s' has no type '%s'; its types: %s" % (ARGS["family_name"], ARGS["type_name"], ", ".join(types[:40]))


def owned_map():
    out = {}
    for e in owned_elements(None, ARGS["tag"], None):
        t = read_tag(e)
        if t is not None and t[1].startswith(KEY_PREFIX):
            out.setdefault(t[1][len(KEY_PREFIX):], []).append(e)
    return out


def classify(crossings, owned):
    plan = []
    skipped = []
    for g in crossings:
        mine = owned.get(g["id"], [])
        h = g["first"]["h"]
        ex = g["ex"]
        if ex is not None:
            ours = ex["src"]["li"] is None and eid(ex["e"]) in [eid(o) for o in mine]
            if not ours:
                t = read_tag(ex["e"]) if ex["src"]["li"] is None else None
                own_other = t is not None and t[0] == ARGS["tag"] and t[1].startswith(KEY_PREFIX)
                skipped.append((g, "existing_own_other" if own_other else "existing_foreign"))
                continue
        if ARGS["mode"] == "opening":
            if h["src"]["li"] is not None:
                skipped.append((g, "host_in_link"))
                continue
            if h["cat"] not in ("walls", "floors", "roofs"):
                skipped.append((g, "opening_needs_wall_floor_or_roof"))
                continue
        plan.append({"g": g, "old": mine, "sizes": []})
    return plan, skipped


# ---- placing one sparing -----------------------------------------------------------------------------------------------
def host_face(g):
    """(reference, location) of the planar host face the sparing is placed on; a linked face gets a link reference."""
    h = g["first"]["h"]
    src = h["src"]
    opt = Options()
    opt.ComputeReferences = True
    geo = h["e"].get_Geometry(opt)
    local = g["c"]
    if src["t"] is not None:
        local = v3(src["t"].Inverse.OfPoint(xyz(g["c"])))
    best = None
    for s in (geo or []):
        if not isinstance(s, Solid):
            continue
        for f in s.Faces:
            fn = getattr(f, "FaceNormal", None)
            if fn is None:
                continue
            k = vdot(vunit(tv(src, v3(fn))), g["n"])
            if abs(k) < 0.999:
                continue
            pr = f.Project(xyz(local))
            if pr is None:
                continue
            score = (0 if k > 0 else 1, pr.Distance)
            if best is None or score < best[0]:
                best = (score, f, pr)
    if best is None:
        raise StepError("no planar face of host %s lies across the crossing; place this sparing by hand" % h["key"], [h["id"]])
    ref = best[1].Reference
    if src["li"] is not None:
        ref = ref.CreateLinkReference(src["li"])
    return ref, tp(src, v3(best[2].XYZPoint))


def place_family(g):
    sym = SYM[0]
    if not sym.IsActive:
        sym.Activate()
    ptype = str(sym.Family.FamilyPlacementType)
    h = g["first"]["h"]
    c = g["c"]
    if ptype == "WorkPlaneBased":
        ref, loc = host_face(g)
        return doc.Create.NewFamilyInstance(ref, xyz(loc), xyz(g["u"]), sym)
    if g["level"] is None:
        raise StepError("the project has no level to place the sparing on", [h["id"]])
    if ptype == "OneLevelBasedHosted":
        if h["src"]["li"] is not None:
            raise StepError("a hosted family cannot be placed in a host of a linked model; use a face-based or unhosted sparing family", [h["id"]])
        return doc.Create.NewFamilyInstance(xyz(c), sym, h["e"], g["level"], StructuralType.NonStructural)
    if ptype == "OneLevelBased":
        inst = doc.Create.NewFamilyInstance(xyz(c), sym, g["level"], StructuralType.NonStructural)
        n = g["n"]
        if abs(n[2]) < 0.999:
            f = v3(inst.FacingOrientation)
            ang = math.atan2(n[1], n[0]) - math.atan2(f[1], f[0])
            if abs(ang) > 1e-9:
                axis = Line.CreateBound(xyz(c), xyz(vadd(c, Z_AXIS)))
                ElementTransformUtils.RotateElement(doc, inst.Id, axis, ang)
        return inst
    raise StepError("family placement type %s is not supported; use a face-based, work-plane based, hosted or unhosted family" % ptype, [h["id"]])


def place_opening(g):
    h = g["first"]["h"]
    hw = g["sw"] * SP_FT_PER_MM / 2.0
    hh = g["sh"] * SP_FT_PER_MM / 2.0
    c, u, v = g["c"], g["u"], g["v"]
    if h["cat"] == "walls":
        p1 = vsub(vsub(c, vmul(u, hw)), vmul(v, hh))
        p2 = vadd(vadd(c, vmul(u, hw)), vmul(v, hh))
        return doc.Create.NewOpening(h["e"], xyz(p1), xyz(p2))
    corners = []
    for su, sv in ((-1, -1), (1, -1), (1, 1), (-1, 1)):
        corners.append(vadd(c, vadd(vmul(u, su * hw), vmul(v, sv * hh))))
    arr = CurveArray()
    for i in range(4):
        arr.Append(Line.CreateBound(xyz(corners[i]), xyz(corners[(i + 1) % 4])))
    return doc.Create.NewOpening(h["e"], arr, True)


def create_sparing(p):
    if ARGS["mode"] == "family":
        return place_family(p["g"])
    return place_opening(p["g"])


def size_values(g):
    """[(parameter name, mm)] for a family sparing."""
    sp = ARGS["size_parameters"]
    out = []
    if "diameter" in sp and (g["shape"] == "round" or not ("width" in sp and "height" in sp)):
        out.append((sp["diameter"], max(g["sw"], g["sh"])))
    else:
        out.append((sp["width"], g["sw"]))
        out.append((sp["height"], g["sh"]))
    if "depth" in sp:
        out.append((sp["depth"], g["sd"]))
    return out


def param_names(e):
    names = []
    try:
        for p in e.Parameters:
            names.append(p.Definition.Name)
    except Exception:
        pass
    names = sorted(set(names))
    return names[:60]


def check_parameters(e):
    """(code, message) when the sparing lacks a parameter this call writes, else None."""
    bad = []
    if ARGS["mode"] == "family":
        for key in ("width", "height", "depth", "diameter"):
            name = ARGS["size_parameters"].get(key)
            if not name:
                continue
            p = e.LookupParameter(name)
            if p is None:
                on_type = SYM[0] is not None and SYM[0].LookupParameter(name) is not None
                bad.append("'%s' (%s) %s" % (name, key, "is a type parameter; this tool sets instance parameters only" if on_type else "does not exist"))
            elif p.IsReadOnly or str(p.StorageType) != "Double":
                bad.append("'%s' (%s) is read-only or not a length" % (name, key))
    sp = ARGS["status_parameter"]
    if sp:
        p = e.LookupParameter(sp)
        if p is None or p.IsReadOnly or str(p.StorageType) != "String":
            bad.append("'%s' (status_parameter) is missing, read-only or not a text parameter" % sp)
    if not bad:
        return None
    what = ("family '%s' type '%s'" % (ARGS["family_name"], ARGS["type_name"])) if ARGS["mode"] == "family" else "a native opening"
    return ("missing_parameter", "%s: %s. Instance parameters it has: %s" % (what, "; ".join(bad), ", ".join(param_names(e)) or "none"))


def probe(first):
    """Place the first sparing in a transaction that is always rolled back, to check its parameters before any change."""
    warnings = []
    errors = []
    txn = Transaction(doc, "AEC sparing parameter probe (rolled back)")
    txn.Start()
    problem = None
    try:
        opts = txn.GetFailureHandlingOptions()
        opts.SetFailuresPreprocessor(Collector(warnings, errors))
        txn.SetFailureHandlingOptions(opts)
        problem = check_parameters(create_sparing(first))
    except Exception as ex:
        problem = ("placement_failed", "the first sparing (crossing %s) could not be placed: %s" % (first["g"]["id"], ex))
    txn.RollBack()
    return problem


def apply_values(e, p):
    g = p["g"]
    if ARGS["mode"] == "family":
        p["sizes"] = size_values(g)
        for name, value in p["sizes"]:
            q = e.LookupParameter(name)
            if q is None or q.IsReadOnly:
                raise StepError("parameter '%s' cannot be set on the new sparing" % name, [eid(e)])
            q.Set(value * SP_FT_PER_MM)
    if ARGS["status_parameter"]:
        q = e.LookupParameter(ARGS["status_parameter"])
        if q is None or q.IsReadOnly:
            raise StepError("status parameter '%s' cannot be set on the new sparing" % ARGS["status_parameter"], [eid(e)])
        q.Set(ARGS["status_value"])
    set_tag(e, ARGS["tag"], KEY_PREFIX + g["id"], "sparing_" + ARGS["mode"])


def check(p, e):
    g = p["g"]
    cid = g["id"]
    got = get_by_id(eid(e))
    post("%s: exists" % cid, got is not None, "id %d" % eid(e))
    if got is None:
        return
    t = read_tag(got)
    post("%s: tag" % cid, t is not None and t[0] == ARGS["tag"] and t[1] == KEY_PREFIX + cid, "tag %s" % (t,))
    for name, want in p["sizes"]:
        q = got.LookupParameter(name)
        have = None
        try:
            have = q.AsDouble() * SP_MM_PER_FT
        except Exception:
            have = None
        post("%s: %s" % (cid, name), have is not None and abs(have - want) <= 0.5, "%s mm (wanted %d mm)" % ("none" if have is None else "%.1f" % have, want))
    if ARGS["status_parameter"]:
        q = got.LookupParameter(ARGS["status_parameter"])
        have = q.AsString() if q is not None else None
        post("%s: status" % cid, have == ARGS["status_value"], "'%s'" % have)
    if ARGS["mode"] == "family":
        loc = None
        try:
            loc = v3(got.Location.Point)
        except Exception:
            loc = None
        if loc is None:
            info("POSITION_UNREADABLE", "%s: the sparing has no location point to check" % cid)
        else:
            off = vsub(loc, g["c"])
            side = vlen(vsub(off, vmul(g["n"], vdot(off, g["n"]))))
            post("%s: position" % cid, side <= 5 * SP_FT_PER_MM, "%.1f mm off the crossing centre in the host plane" % mm(side))
    else:
        host = None
        try:
            host = got.Host
        except Exception:
            host = None
        post("%s: host" % cid, host is not None and eid(host) == g["first"]["h"]["id"], "host %s" % (eid(host) if host is not None else "none"))


def close_dry(run):
    """dry_run: everything was done inside the group; now roll it all back and say so."""
    if run.closed:
        return
    run.closed = True
    failed = bool(run.failed_steps) or run.post_failed > 0
    try:
        if run.group.HasStarted():
            if run.group.RollBack() != TransactionStatus.RolledBack:
                raise StepError("Revit did not roll back the transaction group")
    except Exception as ex:
        fail("GROUP_CLOSE_FAILED", "%s: %s" % (ex.__class__.__name__, ex))
    meta("outcome", "rolled_back" if failed else "dry_run")
    meta("on_error", run.on_error)
    meta("changed_ids", "")
    meta("failed_ids", ",".join([str(i) for i in run.failed_ids]))
    seen = []
    for w in run.warnings:
        if w not in seen:
            seen.append(w)
    for w in seen[:20]:
        info("REVIT_WARNING_DISMISSED", w)
    meta("warnings_dismissed", len(run.warnings))


def main():
    doc_meta()
    res = detect()
    detection_meta(res)
    crossings = res["crossings"]
    every_id = [g["id"] for g in crossings]
    if ARGS["crossing_ids"]:
        known = dict([(g["id"], g) for g in crossings])
        missing = [c for c in ARGS["crossing_ids"] if c not in known]
        if missing:
            refuse("crossing_not_found", "%d crossing_id(s) were not found with these filters: %s" % (len(missing), ", ".join(missing[:20])))
            return
        crossings = [known[c] for c in ARGS["crossing_ids"]]
    if ARGS["mode"] == "family":
        sym, why = find_symbol()
        if sym is None:
            refuse("family_not_found", why)
            return
        SYM[0] = sym
    owned = owned_map()
    plan, skipped = classify(crossings, owned)
    for g, reason in skipped:
        item([("kind", "skipped"), ("crossing_id", g["id"]), ("host_id", g["first"]["h"]["id"]), ("reason", reason),
              ("existing", existing_text(g["ex"])[0])])
    if not ARGS["crossing_ids"]:
        stale = [k for k in owned if k not in every_id]
        if stale:
            ids = []
            for k in stale:
                ids.extend([str(eid(e)) for e in owned[k]])
            info("STALE_SPARING", "%d sparing(s) of tag '%s' no longer match a crossing and were left in place: ids %s" % (len(ids), ARGS["tag"], ",".join(ids[:30])))
    if len(plan) > ARGS["max_sparings"]:
        refuse("too_many_sparings", "%d sparingen would be placed, more than max_sparings=%d" % (len(plan), ARGS["max_sparings"]))
        return
    if not plan:
        meta("outcome", "ok")
        meta("changed_ids", "")
        summary("nothing to place: %d crossings found, %d skipped (an opening is already there or the host does not allow it)" % (len(crossings), len(skipped)))
        return
    if ARGS["mode"] == "family" or ARGS["status_parameter"]:
        problem = probe(plan[0])
        if problem is not None:
            refuse(problem[0], problem[1], [plan[0]["g"]["first"]["h"]["id"]])
            return
    run = Runner("AEC sparingen %s" % ARGS["tag"], ARGS["on_error"])
    made = []
    for p in plan:
        def work(p=p):
            if p["old"]:
                delete_owned(p["old"])
            e = create_sparing(p)
            apply_values(e, p)
            return e

        f = p["g"]["first"]
        e = run.step("Sparing %s" % p["g"]["id"], work, ids=[f["m"]["id"], f["h"]["id"]])
        if e is None:
            continue
        made.append((p, e))
        run.changed.append(eid(e))
    replaced = 0
    for p, e in made:
        check(p, e)
        g = p["g"]
        if p["old"]:
            replaced += 1
        item([("kind", "sparing"), ("id", eid(e)), ("crossing_id", g["id"]), ("action", "replaced" if p["old"] else "created"),
              ("mode", ARGS["mode"]), ("host_id", g["first"]["h"]["id"]), ("w_mm", g["sw"]), ("h_mm", g["sh"]), ("d_mm", g["sd"]),
              ("status", ARGS["status_value"])])
    summary("%d of %d sparingen placed (%d new, %d replaced), %d crossings skipped, %d crossings found%s" % (
        len(made), len(plan), len(made) - replaced, replaced, len(skipped), len(res["crossings"]),
        " - detection TRUNCATED" if res["state"]["stopped"] else ""))
    if ARGS["dry_run"]:
        close_dry(run)


__output__ = run_write(main)
