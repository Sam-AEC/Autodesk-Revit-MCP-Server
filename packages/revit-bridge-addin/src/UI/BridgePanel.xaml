<UserControl x:Class="RevitBridge.UI.BridgePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             MinWidth="360"
             MinHeight="420"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             FontFamily="Segoe UI">
    <Grid Background="#F2F5F8">
        <Grid x:Name="BrowserHost" />

        <Border x:Name="Fallback"
                Visibility="Collapsed"
                Background="#F2F5F8"
                Padding="20">
            <StackPanel VerticalAlignment="Center">
                <Image x:Name="FallbackLogo" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,14" AutomationProperties.Name="AEC Model Bridge logo" />
                <TextBlock Text="AEC Model Bridge"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#18202C"
                           Margin="0,0,0,8" />
                <TextBlock x:Name="FallbackMessage"
                           Text="Panel runtime unavailable."
                           FontSize="13"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           Foreground="#5B6676" />
                <Button x:Name="RetryButton"
                        Content="Retry"
                        Visibility="Collapsed"
                        HorizontalAlignment="Left"
                        Padding="14,5"
                        Margin="0,14,0,0"
                        Click="OnRetryClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
